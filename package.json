{
  "name": "@wuguishifu/gtools",
  "version": "0.0.0",
  "description": "A collection of command line tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuguishifu/gtools.git"
  },
  "type": "module",
  "bin": {
    "gtools": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.2.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "./scripts/build/npm.sh",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "build:binary": "./scripts/build/binary.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "react-devtools-core": "^8.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
